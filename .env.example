# CampusHub Environment Variables
# Copy this file to .env for local development

# Port configurations
GATEWAY_PORT=80
GATEWAY_SSL_PORT=443
MAILHOG_UI_PORT=8025
RABBITMQ_UI_PORT=15672
MINIO_CONSOLE_PORT=9001

# PostgreSQL Configuration
POSTGRES_DB=campushub
POSTGRES_USER=campushub_user
POSTGRES_PASSWORD=campushub_dev_password
POSTGRES_PORT=5432
DB_HOST=postgres

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=campushub_admin
RABBITMQ_DEFAULT_PASS=campushub_mq_secret
RABBITMQ_QUEUE=campushub_registrations

# MinIO Configuration
MINIO_ROOT_USER=campushub_minio
MINIO_ROOT_PASSWORD=campushub_storage_secret
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=campushub

# MailHog SMTP Configuration
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=noreply@campushub.edu

# API Configuration
PORT=3000
NODE_ENV=production
